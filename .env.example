# Copy to .env and add at least one key. Never commit .env (it is git-ignored).
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Mistral (optional, used as a fallback): https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# Which provider's models go first (the other is used as a fallback automatically)
LLM_PROVIDER=groq
# Optional: force a specific model first, or define the whole failover chain
# LLM_MODEL=openai/gpt-oss-120b
# LLM_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,mistral:mistral-small-latest

# Public deployment switches (Hugging Face sets SPACE_ID, which turns server mode on automatically)
# T2C_SERVER_MODE=1
# APP_PASSWORD=choose-a-password
# MAX_BUILDS_PER_HOUR=12
